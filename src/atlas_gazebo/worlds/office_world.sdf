    <!-- ========================================================================
         NỘI THẤT: đổi từ khối hộp màu phẳng sang asset mesh thật (AWS RoboMaker,
         models/README.md) -- GIỮ NGUYÊN vị trí gốc của ChatGPT, chỉ xoay 90° các bàn (DeskC_01
         dài 1.56m theo trục Y cục bộ, xoay để trục dài nằm theo X, khớp hướng bàn hộp gốc
         1.2m(X) x 0.6m(Y)) và NHÍCH ghế ra xa thêm ~0.23m (từ 0.62m lên 0.85m tính từ tâm bàn)
         vì DeskC_01 thật (0.88x1.56m) to hơn hộp gốc (1.2x0.6m) -- đã verify bằng toạ độ tay
         trước khi build, không đoán, tránh chồng lấn bàn/ghế. ========================= -->

    <include><name>desk_1</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-4.000 -3.000 0 0 0 1.5708</pose></include>
    <include><name>chair_1</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-4.000 -3.850 0 0 0 3.14159</pose></include>
    <include><name>desk_2</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-1.000 -3.000 0 0 0 1.5708</pose></include>
    <include><name>chair_2</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-1.000 -3.850 0 0 0 3.14159</pose></include>
    <include><name>desk_3</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-4.000 -0.900 0 0 0 1.5708</pose></include>
    <include><name>chair_3</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-4.000 -1.750 0 0 0 3.14159</pose></include>
    <include><name>desk_4</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-1.000 -0.900 0 0 0 1.5708</pose></include>
    <include><name>chair_4</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-1.000 -1.750 0 0 0 3.14159</pose></include>

    <!-- Quầy lễ tân -- TVCabinet_01 (tủ dài, dáng quầy) xoay ngang cho khớp hướng quầy gốc. -->
    <include><name>reception_counter</name><uri>model://aws_robomaker_residential_TVCabinet_01</uri><pose>-8.000 -4.800 0 0 0 1.5708</pose></include>

    <!-- Góc chờ: sofa thật + bàn cà phê thật. -->
    <include><name>lounge_sofa</name><uri>model://aws_robomaker_residential_SofaB_01</uri><pose>6.000 -5.000 0 0 0 1.5708</pose></include>
    <include><name>lounge_table</name><uri>model://aws_robomaker_residential_CoffeeTable_01</uri><pose>6.000 -3.900 0 0 0 0</pose></include>

    <!-- Kệ lưu trữ -- ShoeRack_01 (kệ thật, thấp hơn khối hộp gốc 2m vì không có asset kệ cao
         sát trần đáng tin cậy trong bộ dữ liệu -- xem models/README.md). -->
    <include><name>storage_shelf_1</name><uri>model://aws_robomaker_residential_ShoeRack_01</uri><pose>-8.500 4.500 0.154 0 0 0</pose></include>
    <include><name>storage_shelf_2</name><uri>model://aws_robomaker_residential_ShoeRack_01</uri><pose>-7.300 4.500 0.154 0 0 0</pose></include>

    <!-- Quầy pantry -- TVCabinet_01 xoay ngang. -->
    <include><name>pantry_counter</name><uri>model://aws_robomaker_residential_TVCabinet_01</uri><pose>-4.400 5.300 0 0 0 1.5708</pose></include>

    <!-- Bàn họp (DeskC_01 xoay ngang) + 3 ghế -- vị trí ghế gốc đã đủ thoáng, không cần nhích
         thêm (đã verify bằng toạ độ tay). -->
    <include><name>meeting_table</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>0.000 4.200 0 0 0 1.5708</pose></include>
    <include><name>meeting_chair_1</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-1.200 4.200 0 0 0 1.5708</pose></include>
    <include><name>meeting_chair_2</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>1.200 4.200 0 0 0 -1.5708</pose></include>
    <include><name>meeting_chair_3</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>0.000 3.300 0 0 0 0</pose></include>

    <!-- Chậu cây -- KHÔNG dùng asset mesh Vase_01: đo thật bằng dae_bbox.py phát hiện bounding
         box 1.08 x 3.1 x 1.39m -- bị lỗi tỉ lệ ở trục Y (cùng loại lỗi file gốc đã gặp ở
         ChairA_01/KitchenTable_01/KitchenCabinet_01/Sofa_01/SofaC_01, không phải do đo sai đơn
         vị). Không có asset "cây cảnh" nào khác đáng tin cậy trong bộ AWS RoboMaker đang có --
         tự dựng chậu (hình trụ nâu đất nung) + tán lá (hình cầu xanh) bằng primitive geometry
         thay vì box vuông phẳng như bản gốc -- đẹp hơn hẳn mà không phụ thuộc asset lỗi. -->
    <model name="plant_obstacle_1">
