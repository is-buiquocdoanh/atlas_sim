<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="atlas_office">

    <!-- Xem giải thích panel GUI này (Visualize Lidar, v.v.) trong maze.sdf -- copy nguyên
         khối GUI/plugin từ đó để world nào cũng có trải nghiệm giống nhau. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.78 0.82</background_color>
        <camera_pose>-14 -16 9 0 0.5 0.85</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizeLidar" name="Visualize Lidar"/>
    </gui>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Giữ nguyên physics đã xác nhận fix bug "xuyên tường" ở maze.sdf: dartsim +
         collision_detector bullet (ODE không có plugin cài sẵn trên máy này). -->
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Văn phòng v2 -- theo phản hồi thực tế: tường hạ tiếp xuống còn ~1m (gần như "mô hình thu
         nhỏ", thấy toàn cảnh từ trên dễ dàng, vẫn đủ cao hơn hẳn mặt phẳng quét LIDAR ~0.14m nên
         không ảnh hưởng SLAM/Nav2), chia 5 PHÒNG ĐÚNG CHỨC NĂNG thay vì 3, thêm nhiều nội thất
         (sofa, bàn cà phê, tủ, kệ, chậu cây) cho giống văn phòng thật hơn.
         Vẫn dùng sàn/tường ngoài thật của warehouse.sdf (GroundB_01 + WallB_01, asset AWS
         RoboMaker, xem models/README.md) -- đã sửa gotcha sàn lún (pose.z=-0.12432, xem chú
         thích chi tiết trong warehouse.sdf). Tường ngăn phòng vẫn là hộp đơn giản tự dựng (không
         phải mesh) để chủ động đúng kích thước + vị trí cửa, nay cũng hạ xuống 1m cho đồng bộ.
         5 phòng theo trục Y (nam → bắc), mỗi phòng 1 chức năng riêng:
           1. Sảnh lễ tân   y: -10.5..-8    (2.5m) -- sofa, bàn cà phê, chậu cây
           2. Khu làm việc  y: -8..1        (9m)   -- 4 bàn + ghế + 1 kệ lưu trữ (có spawn (0,0))
           3. Phòng họp     y: 1..5         (4m)   -- bàn họp + 4 ghế + bảng
           4. Phòng quản lý y: 5..7.5       (2.5m) -- 1 bàn riêng + ghế + tủ
           5. Phòng nghỉ    y: 7.5..10.5    (3m)   -- tủ lạnh, bàn bếp, tủ pantry, bàn trà + ghế
         4 tường ngăn (y=-8/1/5/7.5), MỖI tường chừa đúng 1 cửa rộng 1.2m tại x: -0.6..0.6, CẢ 4
         cửa thẳng hàng nhau -- tạo đúng 1 hành lang thẳng xuyên suốt 5 phòng, robot spawn mặc
         định (0,0) nằm ngay đầu hành lang trong khu làm việc. -->
    <include>
      <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      <pose>0 0 -0.12432 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <pose>0 0 0 0 0 0</pose>
      <scale>1 1 0.111</scale>
    </include>

    <!-- 4 tường ngăn x 2 đoạn (trái/phải), cao 1m, chừa cửa 1.2m ở x: -0.6..0.6 -->
    <model name="partition_wall_1_west"><static>true</static><pose>-3.8 -8 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_1_east"><static>true</static><pose>3.8 -8 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_2_west"><static>true</static><pose>-3.8 1 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_2_east"><static>true</static><pose>3.8 1 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_3_west"><static>true</static><pose>-3.8 5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_3_east"><static>true</static><pose>3.8 5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_4_west"><static>true</static><pose>-3.8 7.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="partition_wall_4_east"><static>true</static><pose>3.8 7.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.4 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.4 0.1 1.0</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual></link>
    </model>

    <!-- Phòng 1 -- sảnh lễ tân (y: -10.5..-8). Sofa/bàn cà phê/chậu cây đặt dọc theo trục X
         (phòng chỉ sâu 2.5m theo Y, không đủ chỗ xếp sofa+bàn nối tiếp theo Y). -->
    <include><name>lobby_sofa</name><uri>model://aws_robomaker_residential_SofaB_01</uri><pose>-5.5 -9.2 0 0 0 1.5708</pose></include>
    <include><name>lobby_coffee_table</name><uri>model://aws_robomaker_residential_CoffeeTable_01</uri><pose>-4 -9.2 0 0 0 0</pose></include>
    <include><name>lobby_plant</name><uri>model://aws_robomaker_residential_Vase_01</uri><pose>6.3 -10.1 0.647 0 0 0</pose></include>

    <!-- Phòng 2 -- khu làm việc (y: -8..1, chứa spawn (0,0)): 4 bàn + ghế, 2 cột x=-4/+4, tránh
         x=0 (hành lang) + 1 kệ lưu trữ dọc tường đông. -->
    <include><name>desk_1</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-4 -6 0 0 0 0</pose></include>
    <include><name>desk_2</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>4 -6 0 0 0 0</pose></include>
    <include><name>desk_3</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>-4 -2 0 0 0 3.14159</pose></include>
    <include><name>desk_4</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>4 -2 0 0 0 3.14159</pose></include>
    <include><name>chair_1</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-4 -7.4 0 0 0 3.14159</pose></include>
    <include><name>chair_2</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>4 -7.4 0 0 0 3.14159</pose></include>
    <include><name>chair_3</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-4 -0.6 0 0 0 0</pose></include>
    <include><name>chair_4</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>4 -0.6 0 0 0 0</pose></include>
    <include><name>storage_shelf</name><uri>model://aws_robomaker_residential_ShoeRack_01</uri><pose>6.1 -4 0.154 0 0 1.5708</pose></include>

    <!-- Phòng 3 -- phòng họp (y: 1..5): bàn họp (DeskC_01 xoay ngang) + 4 ghế + bảng treo tường
         bắc. -->
    <include><name>meeting_table</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>0 3 0 0 0 1.5708</pose></include>
    <include><name>meeting_chair_1</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-1.4 3 0 0 0 1.5708</pose></include>
    <include><name>meeting_chair_2</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>1.4 3 0 0 0 -1.5708</pose></include>
    <include><name>meeting_chair_3</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>0 1.8 0 0 0 0</pose></include>
    <include><name>meeting_chair_4</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>0 4.2 0 0 0 3.14159</pose></include>
    <include><name>meeting_board</name><uri>model://aws_robomaker_residential_Board_01</uri><pose>-2.5 4.85 1.3 0 0 0</pose></include>

    <!-- Phòng 4 -- phòng quản lý riêng (y: 5..7.5, phòng nhỏ, 1 người): 1 bàn + 1 ghế + 1 tủ. -->
    <include><name>manager_desk</name><uri>model://aws_robomaker_warehouse_DeskC_01</uri><pose>0 6.6 0 0 0 0</pose></include>
    <include><name>manager_chair</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>0 5.7 0 0 0 3.14159</pose></include>
    <include><name>manager_cabinet</name><uri>model://aws_robomaker_residential_Wardrobe_01</uri><pose>-3 6.5 0.127 0 0 0</pose></include>

    <!-- Phòng 5 -- phòng nghỉ/pantry (y: 7.5..10.5): tủ lạnh, bàn bếp nhỏ, tủ pantry, bàn trà +
         ghế, thùng rác -- 3 model gốc Z lệch tâm (đo bằng dae_bbox.py, không đoán) đã bù z:
         Refrigerator_01 +0.42, CookingBench_01 +0.5, ReadingDesk_01 +0.266. -->
    <include><name>fridge</name><uri>model://aws_robomaker_residential_Refrigerator_01</uri><pose>-6 10.0 0.42 0 0 0</pose></include>
    <include><name>cooking_bench</name><uri>model://aws_robomaker_residential_CookingBench_01</uri><pose>6 10.0 0.5 0 0 1.5708</pose></include>
    <include><name>pantry_cabinet</name><uri>model://aws_robomaker_residential_TVCabinet_01</uri><pose>0 10.3 0 0 0 1.5708</pose></include>
    <include><name>break_table</name><uri>model://aws_robomaker_residential_ReadingDesk_01</uri><pose>-3.5 8.3 0.266 0 0 0</pose></include>
    <include><name>break_chair_1</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-3.5 9.3 0 0 0 3.14159</pose></include>
    <include><name>break_chair_2</name><uri>model://aws_robomaker_residential_ChairD_01</uri><pose>-2.4 8.3 0 0 0 1.5708</pose></include>
    <include><name>trash_bin</name><uri>model://aws_robomaker_residential_Trash_01</uri><pose>3.8 8.1 0 0 0 0</pose></include>

  </world>
</sdf>
