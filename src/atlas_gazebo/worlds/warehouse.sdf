<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="atlas_warehouse">

    <!-- Xem giải thích panel GUI này (Visualize Lidar, v.v.) trong maze.sdf -- copy nguyên
         khối GUI/plugin từ đó để world nào cũng có trải nghiệm giống nhau. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.78 0.82</background_color>
        <camera_pose>-14 -16 11 0 0.5 0.85</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizeLidar" name="Visualize Lidar"/>
    </gui>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Giữ nguyên physics đã xác nhận fix bug "xuyên tường" ở maze.sdf: dartsim +
         collision_detector bullet (ODE không có plugin cài sẵn trên máy này). -->
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Nhà kho dùng asset thật "AWS RoboMaker Small Warehouse World" (aws_robomaker_warehouse_*,
         models/ -- nguồn + giấy phép ghi trong models/README.md), thay cho các khối màu phẳng cũ
         (nhìn xấu, không giống kho thật). Kích thước gốc đo trực tiếp bằng cách parse float_array
         toạ độ đỉnh trong file .DAE (đơn vị gốc cm, quy đổi mét), không đoán -- xem lại lịch sử
         git để biết số đo gốc chưa scale nếu cần:
           - GroundB_01 + WallB_01 là 1 cặp model THIẾT KẾ KHỚP NHAU: cùng chân đế ~14m (X) x
             21m (Y) -- toà nhà 1 phòng lớn, không mái.
           - ShelfF_01 dài ~18m dọc trục Y của chính nó -- đặt 2 dãy dọc theo chiều dài 21m của
             nhà kho, KHÔNG xoay (yaw=0 khớp hướng trục dài với trục Y nhà kho).
         Sau phản hồi thực tế (tường bản gốc 9m cao hết tầm nhìn orbit camera, kệ bản gốc 6.5m
         cao + đặt sát giữa khiến lối đi chật, robot nhỏ bị "chìm" dưới chân kệ không thấy khác
         biệt giữa các world) -- đã SCALE Z riêng (không méo mặt sàn/chiều dài, chỉ thấp bớt):
           - Tường: scale 1 1 0.3 -> còn ~2.7m, orbit camera nhìn được vào trong không cần bay cao.
           - Kệ: scale 1 1 0.5 -> còn ~3.3m, đẩy ra sát 2 bên tường x=±5 (thay vì ±3.5 bản đầu)
             để lối đi giữa thoáng hẳn ra ~7.9m (x: -3.95..3.95, gấp đôi bản đầu 4.9m), robot
             spawn mặc định (0,0) nằm giữa, không bị kẹp 2 bên kệ cao. -->
    <!-- Lỗi thật gặp khi test: mặt sàn THẬT của GroundB_01 nằm ở z=0.12432m (mesh có đế dày
         ~12.4cm), không phải z=0 -- robot spawn mặc định z=0.05 (đúng bán kính bánh xe) bị lún
         nửa bánh xuống dưới sàn nếu đặt pose.z=0. Đẩy xuống đúng 1 chiều dày (-0.12432) để mặt
         TRÊN khớp world z=0 -- gốc WallB_01 (z=0 cục bộ) tự động khớp theo, không cần đổi. -->
    <include>
      <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      <pose>0 0 -0.12432 0 0 0</pose>
    </include>
    <!-- Tường hạ thấp còn ~2.7m (scale Z 0.3x bản gốc 9.02m thật) -- bản gốc cao hết tầm nhìn,
         orbit camera không nhìn được vào trong. Scale Z riêng không méo mặt sàn/kệ vì WallB_01
         là model độc lập, chỉ ảnh hưởng đúng khối tường. -->
    <include>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <pose>0 0 0 0 0 0</pose>
      <scale>1 1 0.3</scale>
    </include>
    <!-- Kệ hạ còn ~3.3m (scale Z 0.5x bản gốc 6.53m) + đẩy sát 2 bên tường (x=±5, thay vì ±3.5)
         để lối đi giữa thoáng hẳn ra (~7.9m, gấp đôi bản cũ) -- theo đúng yêu cầu "kệ thoáng ra,
         robot đi giữa không bị kẹp 2 bên kệ cao". -->
    <include>
      <name>shelf_row_west</name>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <pose>-5 0 0 0 0 0</pose>
      <scale>1 1 0.5</scale>
    </include>
    <include>
      <name>shelf_row_east</name>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <pose>5 0 0 0 0 0</pose>
      <scale>1 1 0.5</scale>
    </include>

    <!-- Set dressing nhỏ cho giống kho thật đang hoạt động -- đặt trong lối đi giữa (đã thoáng
         ra nhiều), cách spawn (0,0) và mép kệ còn dư biên. Thuần trang trí, không phải vật cản
         bài tập Module 13 (vật cản đó bạn tự thêm sau khi đã lưu map, xem Module 13). -->
    <include>
      <name>pallet_jack</name>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <pose>-3 8 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>trash_can</name>
      <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
      <pose>3 -8 0 0 0 0</pose>
    </include>

  </world>
</sdf>
